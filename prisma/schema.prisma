// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  VERIFIED_STUDENT
  VENDOR
  ADMIN
}

enum ListingType {
  SALE
  RENT
}

enum ProductCategory {
  DECORATION
  EQUIPMENT
  TABLEWARE
  ATTIRE
  PROJECT_TOOLS
}

enum ProductStatus {
  IN_STOCK
  OUT_OF_STOCK
  ON_SALE
  BEST_SELLER
  NEW_ARRIVAL
  FREE_BORROW
  INACTIVE
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  DELIVERED
  RENTAL_ACTIVE
  RETURNED
  COMPLETED
  CANCELLED
}

model User {
  id            String         @id @default(uuid())
  username      String         @unique
  email         String         @unique
  passwordHash  String
  fullname      String
  role          Role           @default(CUSTOMER)
  studentId     String?
  isVerified    Boolean        @default(false)
  trustScore    Float          @default(5.0)
  createdAt     DateTime       @default(now())
  events        Event[]
  products      Product[]      // Products listed by vendor
  orders        BookingOrder[]
  cart          Cart?
  reviews       Review[]
  sessions      Session[]
  subscription  UserSubscription?
  supportTickets SupportTicket[]
  aiUsageCount  Int               @default(0)
  lastAiReset   DateTime          @default(now())
}

model VerificationCode {
  id        String   @id @default(uuid())
  email     String
  code      String   // Plain or hashed 6-digit OTP code
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model PendingRegistration {
  id          String   @id @default(uuid())
  email       String   @unique
  userData    Json     // Stores { passwordHash, fullname, username, role }
  otpHash     String   // Hashed 6-digit OTP code for database leak protection
  attempts    Int      @default(0) // Failed attempt counter (max 3 for brute-force protection)
  expiresAt   DateTime // Expiration date (5 minutes TTL)
  createdAt   DateTime @default(now())

  @@index([email])
}

model PasswordResetRequest {
  id          String   @id @default(uuid())
  email       String   @unique
  otpHash     String   // Hashed 6-digit OTP code
  attempts    Int      @default(0) // Failed attempt counter (max 3 for brute-force protection)
  expiresAt   DateTime // Expiration date (10 minutes TTL)
  createdAt   DateTime @default(now())

  @@index([email])
}

model Session {
  id           String   @id @default(uuid())
  token        String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model Product {
  id                 String               @id @default(uuid())
  sku                String               @unique // Unique Product Code / SKU
  ownerId            String
  owner              User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name               String
  description        String
  category           ProductCategory
  status             ProductStatus        @default(IN_STOCK)
  listingType        ListingType          // Strictly SALE or RENT
  price              Float?               // Price for SALE
  rentalPricePerDay  Float?               // Price for RENT per day
  depositAmount      Float?               // Required deposit for rental
  stock              Int                  @default(1) // Total fallback aggregated stock
  imageUrl           String
  ecoFeatures        String?              @default("")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now()) @updatedAt
  orderItems         OrderItem[]
  bookedDates        BookedDate[]
  cartItems          CartItem[]
  inventories        WarehouseInventory[]
}

model Warehouse {
  id          String               @id @default(uuid())
  name        String               // e.g. "Kho Hà Nội", "Kho TP.HCM"
  location    String
  inventories WarehouseInventory[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
  createdAt   DateTime             @default(now())
}

model WarehouseInventory {
  id          String    @id @default(uuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantity    Int       @default(0) // Available quantity
  reservedQty Int       @default(0) // Quantity temporarily locked during pending checkout

  @@unique([productId, warehouseId])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id          String     @id @default(uuid())
  cartId      String
  cart        Cart       @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId   String
  product     Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  quantity    Int        @default(1)
  startDate   DateTime?
  endDate     DateTime?
}

model BookedDate {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  date      DateTime
}

model BookingOrder {
  id              String      @id @default(uuid())
  buyerId         String
  buyer           User        @relation(fields: [buyerId], references: [id])
  totalAmount     Float
  depositTotal    Float       @default(0)
  platformFee     Float       @default(0)
  status          OrderStatus @default(PENDING_PAYMENT)
  rentalStartDate DateTime?
  rentalEndDate   DateTime?
  createdAt       DateTime    @default(now())
  items           OrderItem[]
}

model OrderItem {
  id          String       @id @default(uuid())
  orderId     String
  order       BookingOrder @relation(fields: [orderId], references: [id])
  productId   String
  product     Product      @relation(fields: [productId], references: [id])
  warehouseId String?
  warehouse   Warehouse?   @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  quantity    Int
  price       Float
}

model Event {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  title       String
  budget      Float
  guestCount  Int
  aiPlanJson  Json
  createdAt   DateTime @default(now())
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}

enum PlanTier {
  FREE
  PLUS
  PREMIUM
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING_PAYMENT
}

model Plan {
  id               String             @id @default(uuid())
  tier             PlanTier           @unique
  name             String
  monthlyPrice     Float
  yearlyPrice      Float
  aiLimitPerMonth  Int                // -1 for unlimited
  maxListings      Int                // -1 for unlimited
  platformFeePct   Float
  hasPdfExport     Boolean            @default(false)
  hasTopSearch     Boolean            @default(false)
  hasPortal        Boolean            @default(false)
  hasAnalytics     Boolean            @default(false)
  subscriptions    UserSubscription[]
}

model UserSubscription {
  id             String                @id @default(uuid())
  userId         String                @unique
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId         String
  plan           Plan                  @relation(fields: [planId], references: [id])
  status         SubscriptionStatus    @default(ACTIVE)
  interval       BillingInterval       @default(MONTHLY)
  startDate      DateTime              @default(now())
  endDate        DateTime
  payments       SubscriptionPayment[]
}

model SubscriptionPayment {
  id             String           @id @default(uuid())
  subscriptionId String
  subscription   UserSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amount         Float
  currency       String           @default("VND")
  paymentMethod  String           @default("VIETQR")
  transactionRef String?          @unique
  status         String           @default("PENDING")
  createdAt      DateTime         @default(now())
  paidAt         DateTime?
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  PRODUCT_LINK
}

enum TicketStatus {
  OPEN
  RESOLVED
  ESCALATED
}

model Conversation {
  id           String    @id @default(uuid())
  participantA String
  participantB String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  messages     Message[]

  @@unique([participantA, participantB])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  content        String?
  type           MessageType  @default(TEXT)
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  attachments    Attachment[]
}

model Attachment {
  id        String      @id @default(uuid())
  messageId String
  message   Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileUrl   String
  fileType  MessageType
  createdAt DateTime    @default(now())
}

model SupportTicket {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  status       TicketStatus @default(OPEN)
  chatHistory  Json
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

